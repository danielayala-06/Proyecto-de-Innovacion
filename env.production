#--------------------------------------------------------------------
# PLANTILLA DE CONFIGURACIÓN PARA PRODUCCIÓN
#
# Copiar este archivo al servidor como ".env" y rellenar los valores.
# NUNCA subir el .env real al repositorio (ya está en .gitignore).
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# BLOQUEANTE 1 — Entorno de producción
# Desactiva Whoops, stack traces y debug info en pantalla.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# BLOQUEANTE 2 — URL base del dominio real
# Debe tener trailing slash. Activa HTTPS obligatorio.
#--------------------------------------------------------------------
app.baseURL                  = 'https://TUDOMINIO.COM/'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE — Credenciales del servidor de producción
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = ronceros_prod
database.default.username = ronceros_user
database.default.password = CONTRASEÑA_SEGURA_AQUI
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port     = 3306

#--------------------------------------------------------------------
# SESIONES EN BASE DE DATOS (ver bloqueante 5)
# Requiere correr: php spark session:migration
#--------------------------------------------------------------------
session.driver   = 'CodeIgniter\Session\Handlers\DatabaseHandler'
session.savePath = 'ci_sessions'

#--------------------------------------------------------------------
# LOGGER — En producción solo errores críticos
#--------------------------------------------------------------------
logger.threshold = 4

#--------------------------------------------------------------------
# CLAVES EXTERNAS
#--------------------------------------------------------------------
DECOLECTA.KEY = TU_API_KEY_RENIEC_AQUI
TUNNEL_SECRET = TU_SECRETO_CLOUDFLARE_AQUI
